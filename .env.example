# RF-W01.9 — URL do backend, lida somente no servidor Next (nunca exposta ao bundle do cliente).
API_BASE_URL=http://localhost:8080/api/v1

# Client ID do Google, usado no botão de login. É público por natureza (aparece no HTML do
# provedor), por isso é o único NEXT_PUBLIC_ do projeto.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
