# RF-W01.9 — URL do backend, lida somente no servidor Next (nunca exposta ao bundle do cliente).
API_BASE_URL=http://localhost:8080/api/v1

# Client ID do Google, usado no botão de login. É público por natureza (aparece no HTML do
# provedor), por isso é o único NEXT_PUBLIC_ do projeto.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Push no navegador (Firebase Cloud Messaging). Identificadores públicos do app web no console do
# Firebase (Configurações do projeto > Seus apps). A chave VAPID fica em Cloud Messaging >
# Configuração da Web > Certificados push da Web. Qualquer uma vazia desliga o push web.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDOPmELgZ7qLOo7Id0sFfTkjQInthg1w2k
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=uaiou-19b9e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=uaiou-19b9e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=uaiou-19b9e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1046458349726
NEXT_PUBLIC_FIREBASE_APP_ID=1:1046458349726:web:35edafb9d64f4f03dd638f
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
